# Empty in local development (Vite proxies /api to port 3000).
# Set to https://your-service.onrender.com in Vercel.
VITE_API_BASE_URL=

# The browser calls the Node API only. Provider credentials belong in server/.env.
VITE_USE_REAL_AI=true
VITE_AI_TEXT_RESPONSE_FORMAT_ENABLED=false

# Keep false until the Render service has an image model configured.
VITE_ENABLE_REAL_IMAGE=false

VITE_AI_MAX_CONCURRENCY=2
VITE_AI_RETRY_COUNT=2
VITE_AI_RETRY_BASE_DELAY_MS=700
VITE_AI_REQUEST_TIMEOUT_MS=120000
