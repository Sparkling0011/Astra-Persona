VITE_API_BASE_URL=/api
VITE_APP_TITLE=Astra Persona

# Set to true to use the real AI service orchestrator in src/api/persona.ts.
# Keep false during local UI development to use deterministic mock data.
VITE_USE_REAL_AI=true

# Text generation: Doubao / Volcano Ark OpenAI-compatible Chat Completions.
# Create an API key in Volcano Engine Ark, then put it in .env.local.
VITE_AI_TEXT_PROVIDER=doubao
VITE_AI_TEXT_API_KEY=your_volcengine_ark_api_key
VITE_AI_TEXT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VITE_AI_TEXT_MODEL=doubao-seed-2-0-pro-260215
VITE_AI_TEXT_CHAT_PATH=/chat/completions
# Keep false for widest Ark compatibility. The prompt still asks the model to return JSON only.
VITE_AI_TEXT_RESPONSE_FORMAT_ENABLED=false

# Image generation is optional. doubao-seed-2-0-pro-260215 outputs text, not images.
# Leave these empty to use the built-in local avatar fallback, or configure a real image model separately.
VITE_AI_IMAGE_PROVIDER=doubao
VITE_AI_IMAGE_API_KEY=
VITE_AI_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VITE_AI_IMAGE_MODEL=
VITE_AI_IMAGE_GENERATION_PATH=/images/generations
VITE_AI_IMAGE_EDIT_PATH=
VITE_AI_IMAGE_POLL_PATH=

VITE_AI_MAX_CONCURRENCY=2
VITE_AI_RETRY_COUNT=2
VITE_AI_RETRY_BASE_DELAY_MS=700
