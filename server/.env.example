NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Volcano Engine Ark credentials stay on the server and are never exposed to Vite.
ARK_API_KEY=your_volcengine_ark_api_key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TEXT_MODEL=doubao-seed-2-0-pro-260215
ARK_TEXT_CHAT_PATH=/chat/completions

# Image generation is optional. Configure an Ark-compatible image endpoint/model when needed.
ARK_IMAGE_API_KEY=
ARK_IMAGE_MODEL=
ARK_IMAGE_GENERATION_PATH=/images/generations
ARK_IMAGE_POLL_PATH=

AI_REQUEST_TIMEOUT_MS=120000
