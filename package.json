  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@8.3.1",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc -b --noEmit",
